# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit a real .env — it contains secrets.

# ===== Core =====
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
TRUST_PROXY=0

# ===== Database (Neon in production) =====
# Use the pooled connection string (host contains "-pooler") and sslmode=require.
DATABASE_URL=postgresql://username:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=10

# ===== Self-hosted authentication =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=micita
JWT_AUDIENCE=micita-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=micita_rt
# COOKIE_DOMAIN=.micita.pe

# Google OAuth (Sign in with Google)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Password policy / hashing (argon2id)
BCRYPT_ROUNDS=12
ARGON_MEMORY_COST=19456
ARGON_TIME_COST=2

# OTP behaviour
EMAIL_OTP_TTL_MINUTES=10
PHONE_OTP_TTL_MINUTES=10
# Non-production only: return the OTP code in the API response for testing.
EXPOSE_OTP_IN_RESPONSE=false

# ===== Email (SMTP, nodemailer) =====
# Solves email OTP + password reset + appointment notifications.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=no-reply@yourdomain.com
EMAIL_PASS=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=MiCita
# "console" logs codes to the server log (dev only). Use "smtp" in production.
EMAIL_OTP_DRIVER=smtp

# ===== SMS / WhatsApp (phone OTP) =====
# PHONE_OTP_DRIVER / SMS_PROVIDER: "console" | "twilio" | "webhook"
PHONE_OTP_DRIVER=console
SMS_PROVIDER=console
# Twilio driver:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Self-hosted bridge driver (e.g. an open-source WhatsApp automation service):
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ===== MercadoPago (payments: Checkout Pro + Preapproval subscriptions) =====
# Dashboard: https://www.mercadopago.com.pe/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Used to validate the x-signature header on webhooks.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_SUCCESS_URL=/dashboard/finanzas?payment=success
MERCADOPAGO_FAILURE_URL=/dashboard/finanzas?payment=failure
MERCADOPAGO_PENDING_URL=/dashboard/finanzas?payment=pending

# ===== Admin =====
# Leave empty in production to disable the legacy bearer-token flow; then only
# authenticated users with role=admin (or an allow-listed email) can access /api/admin.
ADMIN_PASSWORD=
ADMIN_EMAILS=you@yourdomain.com

# ===== Rate limiting =====
API_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5

# ===== Data providers / integrations (existing) =====
APIFY_API_TOKEN=
OPENAI_API_KEY=
PIXABAY_API_KEY=
KAGI_API_KEY=
GOOGLE_MAPS_API_KEY=
