# Database
DATABASE_URL=postgresql://user:password@localhost:5432/micita

# OpenAI API Key for AI Assistant (optional)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@micita.pe
EMAIL_FROM_NAME=MiCita

# Google Places API (Optional - being phased out)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Foursquare API (Free tier: 100,000 requests/month)
# Get your API key at: https://foursquare.com/developers/apps
FOURSQUARE_API_KEY=your_foursquare_api_key

# Apify API (For business scraping)
# Get your API key at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token

# Server Port
PORT=5173